<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全配置：默认仍强制 HTTPS，只对更新清单所在的私有域名放行明文 HTTP。

    原因：更新清单固定走 http://getproxy.wisadelz.cn/update.json（见 Updater.MANIFEST_URL），
    而 Android 9（API 28）起默认禁止明文流量；这里按域名精确放行，
    不整体打开 usesCleartextTraffic，其它域名继续强制 HTTPS。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">getproxy.wisadelz.cn</domain>
    </domain-config>
</network-security-config>